{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:master-storyboarding:video-prompt-identity:1",
  "title": "Video prompt identity and exact upstream bindings, not semantic approval",
  "type": "object",
  "required": ["schema_version", "document_type", "stage", "project_id", "revision", "source_storyboard", "source_narrative", "drafts"],
  "properties": {
    "schema_version": {"const": "video-prompt-1.0"},
    "document_type": {"const": "video.prompt"},
    "stage": {"const": "voiceover-to-video-script"},
    "project_id": {"$ref": "#/$defs/nonempty"},
    "revision": {"$ref": "#/$defs/nonempty"},
    "source_storyboard": {"$ref": "#/$defs/reference", "properties": {"logical_id": {"const": "storyboard.package"}}},
    "source_narrative": {"$ref": "#/$defs/reference", "properties": {"logical_id": {"const": "narrative.package"}}},
    "drafts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["node_id", "prompt", "source_shot_ids"],
        "properties": {
          "node_id": {"$ref": "#/$defs/nonempty"},
          "prompt": {"$ref": "#/$defs/nonempty"},
          "source_shot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}
        }
      }
    }
  },
  "not": {"anyOf": [{"required": ["scenes"]}, {"required": ["story_paragraphs"]}, {"required": ["director_rules"]}, {"required": ["asset_requirements"]}]},
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "reference": {
      "type": "object", "required": ["artifact_id", "logical_id", "revision", "path", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/nonempty"}, "logical_id": {"$ref": "#/$defs/nonempty"},
        "revision": {"$ref": "#/$defs/nonempty"}, "path": {"$ref": "#/$defs/nonempty"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
