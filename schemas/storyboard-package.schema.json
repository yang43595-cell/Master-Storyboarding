{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-storyboarding.local/schemas/storyboard-package.schema.json",
  "title": "storyboard-package 4.0",
  "description": "通用紧凑导演合同：场景公共设定加逐镜决定，保留连续摄影状态与准确对白片段。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "status",
    "source_narrative",
    "source_paragraph_ids",
    "source_dialogue_ids",
    "source_asset_requirement_ids",
    "director_rules",
    "scenes",
    "asset_gaps",
    "open_questions",
    "timing_basis"
  ],
  "properties": {
    "rebuild_provenance": {
      "description": "恢复后候选的可追溯记录，不构成用户确认、生成授权或下游就绪事实。",
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_path", "baseline_sha256", "reason"],
      "properties": {
        "baseline_path": {"$ref": "#/$defs/pathString"},
        "baseline_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "completed_scene_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}},
        "unreviewed_scene_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}},
        "video_generation_authorized": {"const": false},
        "downstream_ready": {"const": false},
        "pending_checks": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "text_review": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "schema_version": {
      "const": "4.0"
    },
    "project_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "revision": {
      "type": "string",
      "pattern": "^R[0-9]{2,}$"
    },
    "status": {
      "enum": [
        "candidate",
        "blocked",
        "confirmed",
        "superseded",
        "rejected"
      ]
    },
    "human_readable_path": {
      "$ref": "#/$defs/pathString",
      "description": "仅历史双文件合同使用；新业务包省略此字段，Markdown 按需导出，不参与业务依赖。"
    },
    "source_narrative": {
      "$ref": "#/$defs/artifactRef"
    },
    "source_paragraph_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/paragraphId"
      }
    },
    "source_dialogue_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dialogueId"
      }
    },
    "source_asset_requirement_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/assetId"
      }
    },
    "director_rules": {
      "$ref": "#/$defs/directorRules"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "asset_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetGap"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "timing_basis": {
      "$ref": "#/$defs/timingBasis"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "pathString": {
      "type": "string",
      "minLength": 3
    },
    "paragraphId": {
      "type": "string",
      "pattern": "^STP-[A-Z0-9-]+$"
    },
    "dialogueId": {
      "type": "string",
      "pattern": "^DLG-[A-Z0-9-]+$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^AST-[A-Z0-9-]+$"
    },
    "shotId": {
      "type": "string",
      "pattern": "^S[0-9]{2,}[A-Z]?-[0-9]{3,}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "logical_id",
        "revision",
        "path"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "logical_id": {
          "const": "narrative.package"
        },
        "revision": {
          "type": "string",
          "pattern": "^R[0-9]{2,}$"
        },
        "path": {
          "$ref": "#/$defs/pathString"
        }
      }
    },
    "directorRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_and_exhibition",
        "narrative_viewpoint",
        "camera_principle",
        "editing_rhythm",
        "light_color_intent",
        "sound_principle",
        "technical_constraint_status"
      ],
      "properties": {
        "focal_length_basis": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "候选焦段的设计或测量依据说明，不自动升级技术条件确认。"
        },
        "aspect_and_exhibition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "narrative_viewpoint": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "camera_principle": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "editing_rhythm": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "light_color_intent": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sound_principle": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "technical_constraint_status": {
          "enum": [
            "unknown_director_intent_only",
            "partial_constraints",
            "shooting_constraints_confirmed"
          ]
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "source_paragraph_ids",
        "dramatic_goal",
        "start_state",
        "change",
        "end_state",
        "space_rules",
        "shots",
        "audiovisual_flow",
        "defaults"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "pattern": "^S[0-9]{2,}[A-Z]?$"
        },
        "source_paragraph_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/paragraphId"
          }
        },
        "dramatic_goal": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "start_state": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "change": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "end_state": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "scene_states": {
          "type": "array",
          "description": "登记原文进入已成立或剧情改变后须持续保留的场景状态；非逐微动作补图清单。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state_id",
              "entity_id",
              "previous_state_id",
              "change_event",
              "description",
              "preserve",
              "changes",
              "source_shot_ids"
            ],
            "properties": {
              "state_id": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "entity_id": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "previous_state_id": {
                "anyOf": [{"type": "null"}, {"$ref": "#/$defs/nonEmptyString"}]
              },
              "change_event": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "description": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "preserve": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              },
              "changes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              },
              "source_shot_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            }
          }
        },
        "space_rules": {
          "$ref": "#/$defs/spaceRules"
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shot"
          }
        },
        "audiovisual_flow": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "defaults": {
          "$ref": "#/$defs/sceneDefaults"
        }
      }
    },
    "spaceRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "screen_direction",
        "subject_positions",
        "key_objects",
        "directional_anchors",
        "light_source",
        "sound_base"
      ],
      "properties": {
        "care_staging": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "本场护理站位、相对空间与素材职责限制。"
        },
        "axis": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "screen_direction": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "subject_positions": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "key_objects": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "directional_anchors": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "light_source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sound_base": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "source_paragraph_ids",
        "source_dialogue_ids",
        "source_asset_requirement_ids",
        "purpose",
        "audio",
        "cut",
        "camera",
        "take",
        "rhythm"
      ],
      "properties": {
        "shot_id": {
          "$ref": "#/$defs/shotId"
        },
        "source_paragraph_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/paragraphId"
          }
        },
        "source_dialogue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dialogueId"
          }
        },
        "source_asset_requirement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/assetId"
          }
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "cut": {
          "$ref": "#/$defs/cut"
        },
        "camera": {
          "$ref": "#/$defs/camera"
        },
        "take": {
          "$ref": "#/$defs/take"
        },
        "rhythm": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "overrides": {
          "$ref": "#/$defs/overrides"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialogue",
        "sfx"
      ],
      "properties": {
        "dialogue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dialoguePlacement"
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "dialoguePlacement": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"presentation": {"const": "ON_SCREEN_TEXT"}},
            "required": ["presentation"]
          },
          "then": {"not": {"required": ["delivery"]}}
        }
      ],
      "required": [
        "dialogue_id",
        "speaker_id",
        "text",
        "presentation"
      ],
      "properties": {
        "delivery": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "可选声音表演说明；保留本片段的语气及跨镜延续，不混入对白原文。"
        },
        "dialogue_id": {
          "$ref": "#/$defs/dialogueId"
        },
        "presentation": {
          "description": "ON_SCREEN_TEXT 只显示原文，不发声、不配旁白、不做口型；speaker_id 仅保留上游归属，显示时机与阅读停留写在 take/rhythm，仍参与全部 DLG 原文与顺序覆盖。",
          "enum": [
            "SYNC",
            "OFFSCREEN",
            "NARRATION",
            "PLAYBACK",
            "ON_SCREEN_TEXT"
          ]
        },
        "timing_basis": {
          "$ref": "#/$defs/timingBasis"
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "speaker_id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "timingBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_type",
        "source_path",
        "source_field"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "既有时长依据来源文件摘要；不改变status或证明实际时长。"
        },
        "status": {
          "enum": [
            "authoritative",
            "not_evaluable"
          ]
        },
        "source_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_field": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "exit",
        "trigger",
        "information_handoff"
      ],
      "properties": {
        "entry": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "exit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "trigger": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "information_handoff": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "assetGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "source_paragraph_ids",
        "affected_shot_ids",
        "related_asset_ids",
        "missing_information",
        "impact",
        "return_required"
      ],
      "properties": {
        "gap_id": {
          "type": "string",
          "pattern": "^GAP-ASSET-[A-Z0-9-]+$"
        },
        "source_paragraph_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/paragraphId"
          }
        },
        "affected_shot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shotId"
          }
        },
        "related_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/assetId"
          }
        },
        "missing_information": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "impact": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "return_required": {
          "const": true
        }
      }
    },
    "sceneDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "light_color_intent",
        "ambience",
        "music"
      ],
      "properties": {
        "light_color_intent": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ambience": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "music": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "light_color_intent": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ambience": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "music": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framing",
        "movement",
        "focus"
      ],
      "properties": {
        "framing": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "movement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "focus": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "take": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "process",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "process": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "end": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
