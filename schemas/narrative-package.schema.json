{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-storyboarding.local/schemas/narrative-package.schema.json",
  "title": "narrative-package 2.0",
  "description": "直接引用已确认故事原文段落 STP、对白 DLG 与资产 AST；旧事件格式仅按历史版本读取。",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "status",
    "objective",
    "locked_facts",
    "story_paragraphs",
    "dialogues",
    "asset_requirements",
    "change_summary",
    "open_questions"
  ],
  "dependentRequired": {"dialogue_evidence_path": ["dialogue_evidence_sha256"], "dialogue_evidence_sha256": ["dialogue_evidence_path"]},
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^R[0-9]{2,}$"
    },
    "status": {
      "enum": [
        "candidate",
        "confirmed",
        "superseded",
        "rejected"
      ]
    },
    "dialogue_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dialogue_evidence_path": {
      "type": "string",
      "minLength": 1,
      "description": "显式绑定单份对白审核记录；新来源核对使用，历史无此字段保持原校验。"
    },
    "human_readable_path": {
      "type": "string",
      "minLength": 1,
      "description": "仅历史双文件合同使用；新业务包省略此字段，Markdown 按需导出，不参与业务依赖。"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "locked_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lockedFact"
      }
    },
    "dialogues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dialogue"
      }
    },
    "asset_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetRequirement"
      }
    },
    "change_summary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "story_paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/storyParagraph"
      }
    }
  },
  "$defs": {
    "lockedFact": {
      "type": "object",
      "required": [
        "fact_id",
        "statement",
        "source_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^FACT-[A-Z0-9-]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dialogue": {
      "type": "object",
      "required": [
        "dialogue_id",
        "speaker_id",
        "text",
        "source_paragraph_id",
        "status",
        "source_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "dialogue_id": {
          "type": "string",
          "pattern": "^DLG-[A-Z0-9-]+$"
        },
        "speaker_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_paragraph_id": {
          "type": "string",
          "pattern": "^STP-[A-Z0-9-]+$"
        },
        "status": {
          "enum": [
            "draft",
            "locked",
            "confirmed"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "performance_intent": {
          "type": "string"
        }
      }
    },
    "assetRequirement": {
      "type": "object",
      "required": [
        "asset_id",
        "category",
        "name",
        "narrative_purpose",
        "source_paragraph_ids",
        "identity_constraints",
        "required_states",
        "interactions",
        "reference_paths",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^AST-[A-Z0-9-]+$"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^CHR-[A-Z0-9-]+$"
        },
        "category": {
          "enum": [
            "CHARACTER",
            "LOCATION",
            "PROP",
            "REAL_PRODUCT",
            "WARDROBE",
            "STYLE_REFERENCE",
            "OTHER"
          ]
        },
        "spatial_scope": {
          "enum": [
            "SINGLE_CONTIGUOUS_SPACE"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "narrative_purpose": {
          "type": "string",
          "minLength": 1
        },
        "source_paragraph_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^STP-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "identity_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reference_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "wardrobe_states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 2
              }
            }
          }
        },
        "image_decision": {
          "enum": [
            "无需独立图",
            "复用现有素材",
            "需要制作",
            "待定"
          ]
        },
        "image_reason": {
          "type": "string",
          "pattern": "\\S"
        },
        "character_type": {
          "enum": [
            "HUMAN",
            "HUMANOID",
            "ANIMAL",
            "NON_HUMANOID",
            "PET"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "CHARACTER"
              }
            }
          },
          "then": {
            "required": [
              "entity_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "LOCATION"
              }
            }
          },
          "then": {
            "required": [
              "spatial_scope"
            ]
          }
        }
      ],
      "dependentRequired": {
        "image_decision": [
          "image_reason"
        ],
        "image_reason": [
          "image_decision"
        ]
      }
    },
    "storyParagraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paragraph_id",
        "text"
      ],
      "properties": {
        "paragraph_id": {
          "type": "string",
          "pattern": "^STP-[A-Z0-9-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
