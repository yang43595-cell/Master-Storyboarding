{
  "schema_version": "1.0",
  "project": {
    "name": "REL-01 正式镜头时间轴逐镜头跟踪验证",
    "fps": 24,
    "duration_seconds": 8,
    "resolution": [540, 960]
  },
  "environment": {
    "preset": "studio",
    "width": 10,
    "depth": 12,
    "height": 4.5
  },
  "actors": [
    {
      "id": "actor.meet.A",
      "role": "generic",
      "asset": "quaternius.ual1-standard",
      "display_color": "#D55E00",
      "position": [-3.5, -0.5, 0],
      "rotation_degrees": 90,
      "scale": 0.9,
      "actions": [
        {
          "preset": "walk",
          "start": 0,
          "duration": 8,
          "to": [3.5, -0.5, 0],
          "step_length": 0.65,
          "motion_clip": "Walk_Loop",
          "motion_steps_per_cycle": 2
        }
      ]
    },
    {
      "id": "actor.meet.B",
      "role": "generic",
      "asset": "quaternius.ual1-standard",
      "display_color": "#009E73",
      "position": [3.5, 0.5, 0],
      "rotation_degrees": -90,
      "scale": 0.9,
      "actions": [
        {
          "preset": "walk",
          "start": 0,
          "duration": 8,
          "to": [-3.5, 0.5, 0],
          "step_length": 0.65,
          "motion_clip": "Walk_Loop",
          "motion_steps_per_cycle": 2
        }
      ]
    }
  ],
  "camera": {
    "lens_mm": 35,
    "shots": [
      {
        "id": "S01",
        "label": "双人相遇定场",
        "purpose": "同时交代两人运动方向和相遇关系",
        "shot_size": "wide",
        "start": 0,
        "end": 2.5,
        "position_space": "world",
        "keyframes": [
          {"time": 0, "position": [0, -11, 3.2], "look_at": [0, 0, 1.15], "lens_mm": 24},
          {"time": 2.5, "position": [0, -9.5, 2.8], "look_at": [0, 0, 1.15], "lens_mm": 28}
        ]
      },
      {
        "id": "S02",
        "label": "跟随人物A",
        "purpose": "切入人物A并保持人物B继续运动",
        "shot_size": "medium",
        "start": 2.5,
        "end": 4.5,
        "position_space": "tracking_actor_relative",
        "tracking_actor": "actor.meet.A",
        "keyframes": [
          {"time": 0, "position": [2.4, -4.8, 2.2], "look_at": [0, 0, 1.25], "lens_mm": 42},
          {"time": 2, "position": [1.5, -3.8, 2.0], "look_at": [0.2, 0, 1.3], "lens_mm": 48}
        ]
      },
      {
        "id": "S03",
        "label": "跟随人物B",
        "purpose": "切换跟踪目标到人物B并保留人物A运动连续性",
        "shot_size": "medium_close",
        "start": 4.5,
        "end": 6.5,
        "position_space": "tracking_actor_relative",
        "tracking_actor": "actor.meet.B",
        "keyframes": [
          {"time": 0, "position": [-2.2, -4.2, 2.1], "look_at": [0, 0, 1.3], "lens_mm": 48},
          {"time": 2, "position": [-1.4, -3.4, 1.95], "look_at": [-0.2, 0, 1.35], "lens_mm": 55}
        ]
      },
      {
        "id": "S04",
        "label": "双人关系落幅",
        "purpose": "回到世界坐标全景交代两人最终位置",
        "shot_size": "wide",
        "start": 6.5,
        "end": 8,
        "position_space": "world",
        "keyframes": [
          {"time": 0, "position": [0, -9.5, 2.8], "look_at": [0, 0, 1.15], "lens_mm": 30},
          {"time": 1.5, "position": [0, -11, 3.2], "look_at": [0, 0, 1.15], "lens_mm": 26}
        ]
      }
    ]
  },
  "lighting": {"preset": "soft_daylight"},
  "outputs": {
    "blend": true,
    "preview_video": true,
    "still_frames": [0, 2.4, 2.6, 4.4, 4.6, 6.4, 6.6, 8],
    "reference_views": [
      {
        "id": "REF-S01-TIMELINE-WIDE",
        "time": 1.5,
        "mode": "timeline_camera",
        "purpose": "分镜图采用的双人相遇全景与动作方向参考",
        "shot_id": "S01"
      },
      {
        "id": "REF-A-FRONT-FULL",
        "time": 3.25,
        "mode": "coverage_camera",
        "purpose": "人物A正面全身动作参考",
        "shot_id": "S02",
        "subject_ids": ["actor.meet.A"],
        "orientation_actor": "actor.meet.A",
        "shot_size": "full",
        "view_direction": "front",
        "direction_space": "subject",
        "elevation": "eye",
        "occlusion_policy": "film_set_hide_occluders",
        "lens_mm": 50
      },
      {
        "id": "REF-A-LEFT-MEDIUM",
        "time": 3.25,
        "mode": "coverage_camera",
        "purpose": "人物A左侧中景动作参考",
        "shot_id": "S02",
        "subject_ids": ["actor.meet.A"],
        "orientation_actor": "actor.meet.A",
        "shot_size": "medium",
        "view_direction": "left",
        "direction_space": "subject",
        "elevation": "eye",
        "occlusion_policy": "film_set_hide_occluders"
      },
      {
        "id": "REF-B-FRONT-MEDIUM-CLOSE",
        "time": 5.25,
        "mode": "coverage_camera",
        "purpose": "人物B正面中近景动作参考",
        "shot_id": "S03",
        "subject_ids": ["actor.meet.B"],
        "orientation_actor": "actor.meet.B",
        "shot_size": "medium_close",
        "view_direction": "front",
        "direction_space": "subject",
        "elevation": "eye",
        "occlusion_policy": "film_set_hide_occluders"
      },
      {
        "id": "REF-PAIR-RIGHT-WIDE",
        "time": 6.75,
        "mode": "coverage_camera",
        "purpose": "双人关系右侧全景与屏幕方向参考",
        "shot_id": "S04",
        "subject_ids": ["actor.meet.A", "actor.meet.B"],
        "shot_size": "wide",
        "view_direction": "right",
        "direction_space": "world",
        "elevation": "eye",
        "occlusion_policy": "film_set_hide_occluders"
      },
      {
        "id": "REF-PAIR-OVERHEAD-WIDE",
        "time": 6.75,
        "mode": "coverage_camera",
        "purpose": "双人站位俯视全景与空间关系参考",
        "shot_id": "S04",
        "subject_ids": ["actor.meet.A", "actor.meet.B"],
        "shot_size": "wide",
        "view_direction": "front",
        "direction_space": "world",
        "elevation": "overhead",
        "occlusion_policy": "film_set_hide_occluders",
        "lens_mm": 45
      }
    ],
    "actor_color_mode": "auto",
    "render_style": "role_colors"
  }
}
