+  else if(metadata.binding)sourceVideoHTML='<p class="project-warning" role="status">本版本对标原视频缺失，请补充本版本的对标视频后重新发布。</p>';
   const nav=`<nav aria-label="项目阶段"><ol class="case01-review-stages case01-unified-stages">${stages.map(([id,title],i)=>{const available=(c.id!=='05'&&!contentOnly(c.id))||id==='script'||hasStage(c.id,id),open=available?`a href="${esc(href({stage:id,area:id==='script'?null:'production','content-version':null}))}"${id===stage?' aria-current="page"':''}`:'span class="review-stage-unavailable" aria-disabled="true"';return `<li${id===stage?' aria-current="step"':''}><${open}><span class="case01-stage-number">${String(i+1).padStart(2,'0')}</span><div><strong>${title}</strong><span${stage==='assets'&&id===stage?' data-content-asset-status':''}>${id===stage?revision+' · 待核对':available?'查看本阶段':'尚未开放'}</span></div></${available?'a':'span'}></li>`}).join('')}</ol></nav>`;
