   let metadata;try{metadata=global.ReviewPackageMetadata.read(p);}catch(error){panel.innerHTML='<p class="error">内容包来源校验失败：'+esc(error.message)+'。本版本不可审核，请修正后重新发布。</p>';return true;}
   if(metadata.benchmark)sourceVideoHTML=global.ReviewPackageMetadata.render(metadata.benchmark,c.id);
