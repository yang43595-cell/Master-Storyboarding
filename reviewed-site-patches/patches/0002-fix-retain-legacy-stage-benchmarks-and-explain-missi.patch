-  if(stage==='assets'){active=global.ReviewSubscribedAssets.mount({c,panel,item,nav,scope,href,sourceVideo:metadata.benchmark?sourceVideoHTML:''});return true;}
+  if(stage==='assets'){active=global.ReviewSubscribedAssets.mount({c,panel,item,nav,scope,href,sourceVideo:sourceVideoHTML});return true;}
   // Director cards reuse the retained stage layout while comments stay on immutable source spans.
   const directorView=stage==='director'&&global.ReviewSubscribedDirector?.supports(p)?global.ReviewSubscribedDirector:null;
   // Other stages keep their own stage-specific presentation.
@@ -36,7 +36,7 @@
   const captionHTML=m=>assetStage?(()=>{const [title,...notes]=String(m.caption||'').split('｜');return `<strong>${esc(title)}</strong>${notes.map(note=>`<p class="asset-caption">${esc(note)}</p>`).join('')}`;})():esc(m.caption);
   const blocks=p.blocks.filter(b=>b.id!=='benchmark-reference').map(b=>{if(directorView)return directorView.renderBlock(b);const cards=b.media.map(m=>{const url=mediaURL(m.url);if(!url)return '<p class="error">媒体地址无效</p>';return `<figure class="c01-media-card" data-content-media="${esc(m.id)}">${m.mime==='video/mp4'?`<video controls preload="metadata" playsinline src="${esc(url)}"></video>`:`<a href="${esc(url)}" target="_blank" rel="noopener noreferrer" aria-label="查看${esc(m.caption||b.heading)}原图"><img src="${esc(url)}" alt="${esc(m.caption||b.heading)}" loading="lazy" decoding="async"></a>`}<figcaption>${captionHTML(m)}</figcaption></figure>`}).join('');const tag=assetStage?'details':'section';return `<${tag} class="content-package-block${assetStage?' simple-details content-asset-group':''}" id="content-block-${esc(b.id)}" data-content-block="${esc(b.id)}"${assetStage?' open':''}>${assetStage?`<summary>${esc(b.heading)}${b.media.length?`<span>${b.media.length} 项</span>`:''}</summary>`:`<h4>${esc(b.heading)}</h4>`}${b.text?`<div class="content-package-text">${esc(b.text)}</div>`:''}${assetStage&&cards?`<div class="review-images content-asset-grid">${cards}</div>`:cards}</${tag}>`;}).join('');
   const pageBody=`${scope==='qa'?'<p class="project-warning">隔离测试内容与测试意见，不代表用户审核，不影响正式版本</p>':''}<p id="content-live-notice" class="content-live-notice" role="status">${pinned&&!item.isCurrent?'正在查看历史版本，当前版本仍保留。':'内容已同步 · '+revision}</p><section class="deliverable content-package${assetStage?' content-assets':''}${directorView?' content-director c01-stage-view':''}" id="subscribed-content"><div class="deliverable-head"><h3>${stage==='script'?'编导稿':esc(p.title)}</h3><span>${revision}</span></div>${p.summary?`<p class="content-package-summary">${esc(p.summary)}</p>`:''}${item.sourceStale?'<p class="project-warning content-source-warning">来源编导稿已有更新，本包保留供对照，需新版本后再通过。</p>':''}<p class="reading-note"${assetStage?' data-content-asset-note':''}>${p.reviewable?'本阶段候选，待你验收':'过程核对版，可评论，尚不能通过'} · 每条意见绑定本版本</p>${stage==='script'?'':`<nav class="case-actions" data-review-navigation-title="${assetStage?'资产目录':'本阶段目录'}" aria-label="${assetStage?'选择资产分组':'本阶段目录'}">${directorView?directorView.navigation(p.blocks):p.blocks.map(b=>`<a href="#content-block-${esc(b.id)}">${esc(b.heading)}${assetStage&&b.media.length?`（${b.media.length}项）`:''}</a>`).join('')}</nav>`}${stage==='script'?`<div class="content-script-layout"><div class="content-script-story">${blocks}</div><aside class="content-script-comments"></aside></div>`:blocks}</section><details class="simple-details content-package-history"><summary>历史版本与意见</summary><div id="content-history"></div><a href="${esc(href({'legacy-content':'1','content-version':null}))}">查看保留的原有内容与审核记录</a><p class="reading-note">来源编导版本 ${esc(p.sourceScriptVersion.slice(0,12))} · 本阶段版本 ${esc(version.slice(0,12))}</p></details>`;
-  panel.innerHTML=stage==='script'?global.ReviewScriptTemplate.page(c,{navigation:nav,sourceVideo:sourceVideoHTML,body:pageBody,test:scope==='qa'}):`<header class="case-heading"><p class="case-kicker">案例 ${esc(c.id)}${scope==='qa'?' · 隔离测试':''}</p><h2>${esc(c.title)}</h2>${nav}</header>${metadata.benchmark?sourceVideoHTML:''}${pageBody}<footer class="page-footer">当前仅你可见 · 内容更新无需重新发布网页</footer>`;
+  panel.innerHTML=stage==='script'?global.ReviewScriptTemplate.page(c,{navigation:nav,sourceVideo:sourceVideoHTML,body:pageBody,test:scope==='qa'}):`<header class="case-heading"><p class="case-kicker">案例 ${esc(c.id)}${scope==='qa'?' · 隔离测试':''}</p><h2>${esc(c.title)}</h2>${nav}</header>${sourceVideoHTML}${pageBody}<footer class="page-footer">当前仅你可见 · 内容更新无需重新发布网页</footer>`;
   const section=panel.querySelector('#subscribed-content'),index=section.querySelector('nav');
   const navigation=stage==='script'?null:global.ReviewAssetNavigation?.mount(section,index);
   const host=stage==='script'?section.querySelector('.content-script-comments'):(navigation?.editorHost||section.appendChild(document.createElement('aside')));
