 const results = [];
 async function test(name, fn) { try { await fn(); results.push({ name, passed: true }); } catch (error) { results.push({ name, passed: false, error: error.stack }); } }
 if (require.main === module) (async () => {
+  await test('legacy stage benchmark survives assets and generic stage rendering; bound missing source is explicit and never uses registry', async () => {
+    const fallback='<section class="benchmark-source"><video src="verified-case05-registry"></video></section>';
+    const binding={id:'source-binding',heading:'来源',text:JSON.stringify({schemaVersion:1,source_sha256:'c'.repeat(64),native_sha256:'d'.repeat(64)}),media:[]};
+    const benchmark={id:'benchmark-reference',heading:'对标',text:JSON.stringify({schemaVersion:1,sourceUrl:'https://www.douyin.com/video/7696423488042601771',sourceVideoId:'7696423488042601771',author:'测试',clipStartSeconds:0,clipEndSeconds:69,clipLabel:'包内片段',videoMediaId:'video',posterMediaId:'poster'}),media:[media('video','e','原片','video/mp4'),media('poster','f','封面','image/jpeg')]};
+    for(const stage of ['script','assets','director','white_model','storyboard','prompts']) {
+      for(const historical of [false,true]) {
+        const content={...fixture().content,caseId:'05',stage};
+        const item=fixture({caseId:'05',stage,content,isCurrent:!historical});
+        const options={caseId:'05',item,actualAssets:stage==='assets',search:'?stage='+stage+'&content-test=1'+(historical?'&content-version='+V1:''),sourceVideoHTML:fallback};
+        const legacy=runtime(options);await legacy.start();assert.equal(legacy.panel.querySelector('video').getAttribute('src'),'verified-case05-registry',stage+' legacy history='+historical);
+        // Bound script requires its benchmark at schema level; other stages must explain missing source.
+        if(stage!=='script') {
+          const bound=runtime({...options,item:deep(item)});bound.server.item.content.blocks.push(binding);await bound.start();
+          assert.match(bound.panel.textContent,/对标原视频缺失/);
+          assert.equal(bound.panel.querySelector('video')?.getAttribute('src')==='verified-case05-registry',false);
+        }
+        const embedded=runtime({...options,item:deep(item)});embedded.server.item.content.blocks.push(binding,benchmark);await embedded.start();
+        const player=embedded.panel.querySelector('video');assert.equal(player.getAttribute('src'),benchmark.media[0].url);assert.equal(player.getAttribute('poster'),benchmark.media[1].url);
+        assert.equal(player.getAttribute('autoplay'),null);assert.equal(embedded.panel.querySelectorAll('[data-package-benchmark]').length,1);
+      }
+    }
+    // An unrelated registry player supplied by a caller cannot override a bound package.
+    const item=fixture();item.content.blocks.push(binding);
+    const wrong=runtime({item,sourceVideoHTML:'<video src="wrong-case-registry"></video>'});await wrong.start();assert.equal(wrong.panel.querySelector('video')?.getAttribute('src')==='wrong-case-registry',false);assert.match(wrong.panel.textContent,/对标原视频缺失/);
+  });
   await test('malformed declared benchmark fails closed without showing legacy player or approval controls',async()=>{
    const item=fixture();item.content.blocks.push({id:'benchmark-reference',heading:'对标',text:'{}',media:[]});
    const r=runtime({item});await r.start();await r.flush();assert.match(r.panel.textContent,/来源校验失败/);assert.equal(r.panel.querySelector('video'),null);assert.equal(r.panel.querySelector('#content-approve'),null);assert.equal(r.posts.length,0);
