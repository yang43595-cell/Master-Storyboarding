      "passed": true
    },
    {
      "name": "old subscribed selection quotes and every historical reference remain accessible",
      "passed": true
    },
    {
      "name": "already committed old pending IDs reconcile without duplicate feedback or draft deletion",
      "passed": true
    },
    {
      "name": "unknown old pending IDs stay blocked until an explicit exact-ID retry",
      "passed": true
    },
    {
      "name": "subscribed script never posts if persisting its retry ID fails",
      "passed": true
    },
    {
      "name": "late disposed script receipt cannot approve the newly mounted version badge",
      "passed": true
    },
    {
      "name": "clean remote script references rebase UI and persisted drafts without restoring older images",
      "passed": true
    },
    {
      "name": "same-version old subscribed drafts migrate without deletion and failed uploads remain blocked",
      "passed": true
    },
    {
      "name": "nonasset subscribed stages retain their own markup, controls and caption content",
      "passed": true
    },
    {
      "name": "strict package renders stage navigation, text, immutable image/video media, and one submit",
      "passed": true
    },
    {
